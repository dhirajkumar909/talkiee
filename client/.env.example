# Copy this file to `.env` (same folder) and fill in values from your Supabase
# project (green "Connect" button → App Frameworks, or Project Settings →
# Data API for the URL / API Keys for the anon/publishable key).
# Use the base URL with NO trailing slash and NO /rest/v1.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: a YouTube Data API key makes speaker song-name search more reliable.
# Without it, search falls back to public Piped/Invidious instances, and pasting
# YouTube links/playlists always works regardless.
VITE_YT_API_KEY=
